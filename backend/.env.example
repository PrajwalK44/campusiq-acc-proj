# ==============================================================================
# CampusIQ Backend Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=CampusIQ
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Database Connection (Supabase PostgreSQL standard URI)
# Obtain your connection URI from Supabase Project Settings -> Database.
# Direct Connection format:
#   postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Connection Pooler (Session Mode) format:
#   postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Note: If your password has special characters like '@', percent-encode them (e.g. %40).
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# JWT Authentication Settings
# Generate a secure key using: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_random_32_byte_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# LLM Provider (Groq Cloud)
# Obtain a free API key at https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# Embeddings
# Uses local Sentence-Transformers model. Will download weights on first startup.
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# ChromaDB Vector Database
# Mode: "embedded" (persists to local disk) or "server" (connects via HTTP host/port)
# ------------------------------------------------------------------------------
CHROMA_MODE=embedded
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=campusiq_documents
# Required only if CHROMA_MODE=server (e.g. in Kubernetes or Docker Compose):
CHROMA_SERVER_HOST=chromadb
CHROMA_SERVER_PORT=8000

# ------------------------------------------------------------------------------
# Document Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=20

# ------------------------------------------------------------------------------
# RAG Retrieval Parameters
# ------------------------------------------------------------------------------
RAG_TOP_K=5
# Minimum cosine similarity threshold (0.0 to 1.0). If best chunk score is below this, system abstains.
RAG_SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
