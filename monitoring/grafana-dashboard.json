  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "FastAPI HTTP Requests Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (handler, status)",
          "legendFormat": "{{handler}} - {{status}}"
        }
      ]
    },
    {
      "title": "P95 Request Latency (seconds)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency"
        }
      ]
    },
    {
      "title": "HTTP 5xx Error Rate",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx Errors/sec"
        }
      ]
    },
    {
      "title": "Backend Memory Usage",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"campusiq-backend\"} / (1024 * 1024)",
          "legendFormat": "Resident Memory (MB)"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["campusiq", "kubernetes"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
